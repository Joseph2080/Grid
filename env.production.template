# Spring runtime
SPRING_PROFILES_ACTIVE=prod
APP_PORT=8080
APP_BASE_URL=https://your-domain.example
PAYMENT_STRATEGY=STRIPE

# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://your-db-host:5432/vektrlabs
SPRING_DATASOURCE_USERNAME=vektrlabs_app
SPRING_DATASOURCE_PASSWORD=replace-in-ssm

# AWS Cognito
COGNITO_ISSUER_URI=https://cognito-idp.eu-central-1.amazonaws.com/your_user_pool_id
COGNITO_CLIENT_ID=replace-in-ssm
COGNITO_CLIENT_SECRET=replace-in-ssm
COGNITO_LOGOUT_URI=https://your-domain.example/logout
APP_POST_LOGOUT_REDIRECT_URI=https://your-domain.example/

# Session cookie hardening
SESSION_COOKIE_SECURE=true

# Stripe (live)
STRIPE_PUBLISHABLE_KEY=pk_live_replace
STRIPE_SECRET_KEY=sk_live_replace
